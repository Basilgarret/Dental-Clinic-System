# Copy this file to ".env" and fill in the password you set when you
# installed PostgreSQL. Never commit the real ".env" file — it's already
# listed in .gitignore.

PGHOST=localhost
PGPORT=5432
PGDATABASE=wellstone_dental
PGUSER=postgres
PGPASSWORD=1434

# Port the API server itself listens on
PORT=4000

# Optional Google Maps Embed API browser key. Restrict it to your app's HTTP referrers.
GOOGLE_MAPS_API_KEY=

# Gmail API OAuth 2.0 credentials for account verification and password resets.
# Keep these server-side and never commit real values.
APP_BASE_URL=http://localhost:4000
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/oauth2callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
